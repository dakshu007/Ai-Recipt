{
  "name": "sheetscan-server",
  "version": "1.0.0",
  "private": true,
  "description": "SheetScan backend API — owns the Gemini key, auth, metering, and billing",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node --env-file=.env --experimental-strip-types src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0",
    "helmet": "^8.1.0",
    "stripe": "^18.2.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
