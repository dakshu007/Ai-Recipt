# Copy to .env for local development. NEVER commit a real .env file.
# In production, inject these via your platform's secret manager
# (Cloud Run + Secret Manager, Fly.io secrets, etc.), not a file.

NODE_ENV=development
PORT=8080

# --- Gemini (required) -------------------------------------------------------
# The ONLY place this key lives. Users and the add-on never see it.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000

# --- Auth (required) ---------------------------------------------------------
# Comma-separated OAuth client IDs accepted as the `aud` claim of incoming
# Google ID tokens. For the Apps Script add-on this is the OAuth client ID of
# the script's GCP project (visible under Project Settings in Apps Script).
ALLOWED_OAUTH_AUDIENCES=1234567890-example.apps.googleusercontent.com

# Local development ONLY — skips token verification and acts as "sub:email".
# The server refuses to start if this is set with NODE_ENV=production.
#DEV_FAKE_USER=dev-user-1:dev@example.com

# --- Quotas & limits ---------------------------------------------------------
FREE_DAILY_LIMIT=5
PRO_DAILY_LIMIT=500
MAX_TEXT_CHARS=20000
MAX_IMAGE_BYTES=4194304
RATE_LIMIT_PER_MINUTE=10

# --- Stripe billing (optional; set both or neither) --------------------------
# Webhook endpoint to configure in Stripe: POST /v1/billing/webhook
# Events needed: checkout.session.completed, customer.subscription.deleted
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...
